# ==============================================
# Al Boukhari Payments — Production .env template
# ==============================================
# Copy this to .env on the server, fill real values, then run:
#   php artisan key:generate     (only once, at first deploy)
#   php artisan config:cache
# NEVER commit the real .env — only .env.production.example
# ==============================================

APP_NAME="Al Boukhari — Payments"
APP_ENV=production
APP_KEY=                              # ← run `php artisan key:generate` on the server to fill
APP_DEBUG=false                       # MUST be false in production (leaking secrets otherwise)
APP_URL=https://payments.alboukhari.nl
APP_TIMEZONE=Europe/Amsterdam

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The dev server uses SERVER_PORT — no effect in production (Apache/Nginx handles ports).
# SERVER_PORT=8009

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning                     # keep logs quiet in production

# ---------- Database (MySQL/MariaDB on Hostinger) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u475164459_payments       # ← replace with the DB name Hostinger gave you
DB_USERNAME=u475164459_payments       # ← DB user
DB_PASSWORD=                          # ← DB password (strong, no spaces)

# ---------- Session / Cache / Queue (all DB-backed, no Redis needed) ----------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true            # HTTPS-only cookies
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ---------- Mail ----------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com          # or your provider's SMTP
MAIL_PORT=587
MAIL_USERNAME=noreply@alboukhari.nl
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@alboukhari.nl"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- BulkGate (SMS provider) ----------
# Preferred: manage these via /settings UI (stored encrypted in DB).
# These env vars are only used as a fallback if DB values are empty.
BULKGATE_APP_ID=
BULKGATE_APP_TOKEN=
BULKGATE_SENDER_ID=text
BULKGATE_SENDER_ID_VALUE="Al Boukhari"
BULKGATE_DEFAULT_COUNTRY=NL

# ---------- WhatsApp Cloud API (optional) ----------
# Set in /settings UI too. Leave blank here unless you need env-level defaults.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------- AWS S3 (not used — kept for Laravel default compatibility) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
